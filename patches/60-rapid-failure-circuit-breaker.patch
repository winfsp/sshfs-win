+#ifdef __CYGWIN__
+#define QUICK_FAILURE_LIMIT 32
+#define QUICK_FAILURE_WINDOW 10
+
+static volatile LONG quick_failure_count;
+static volatile LONG quick_failure_start;
+
+static int request_health_type(uint8_t type)
+{
+	return type == SSH_FXP_OPEN || type == SSH_FXP_READ ||
+		type == SSH_FXP_LSTAT || type == SSH_FXP_FSTAT ||
+		type == SSH_FXP_OPENDIR || type == SSH_FXP_READDIR ||
+		type == SSH_FXP_REALPATH;
+}
+
+static void request_health_success(uint8_t type)
+{
+	if (!request_health_type(type))
+		return;
+
+	InterlockedExchange(&quick_failure_count, 0);
+	InterlockedExchange(&quick_failure_start, 0);
+}
+
+static void request_health_failure(uint8_t type)
+{
+	struct timeval now;
+	LONG start;
+	LONG count;
+
+	if (!request_health_type(type))
+		return;
+
+	gettimeofday(&now, NULL);
+	start = InterlockedCompareExchange(&quick_failure_start,
+		(LONG) now.tv_sec, 0);
+	if (start == 0)
+		start = (LONG) now.tv_sec;
+	if ((LONG) now.tv_sec - start > QUICK_FAILURE_WINDOW) {
+		InterlockedExchange(&quick_failure_count, 0);
+		InterlockedExchange(&quick_failure_start, (LONG) now.tv_sec);
+	}
+
+	count = InterlockedIncrement(&quick_failure_count);
+	if (count >= QUICK_FAILURE_LIMIT) {
+		fprintf(stderr,
+			"connection returned %ld rapid failures; terminating mount\n",
+			(long) count);
+		fflush(stderr);
+		_exit(EIO);
+	}
+}
+#else
+static void request_health_success(uint8_t type) { (void) type; }
+static void request_health_failure(uint8_t type) { (void) type; }
+#endif
