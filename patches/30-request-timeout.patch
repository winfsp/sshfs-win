 	GHashTable *r_gid_map;
 	unsigned max_read;
 	unsigned max_write;
+	unsigned request_timeout;
 	unsigned ssh_ver;
 	int sync_write;
 	int sync_read;
@@ -498,6 +499,7 @@ static struct fuse_opt sshfs_opts[] = {
 	SSHFS_OPT("sftp_server=%s",    sftp_server, 0),
 	SSHFS_OPT("max_read=%u",       max_read, 0),
 	SSHFS_OPT("max_write=%u",      max_write, 0),
