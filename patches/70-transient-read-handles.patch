+static int sshfs_open_transient_read(struct sshfs_file *sf,
+				     struct buffer *handle)
+{
+	struct buffer buf;
+	int err;
+
+	buf_init(&buf, 0);
+	buf_add_path(&buf, sf->path);
+	buf_add_uint32(&buf, SSH_FXF_READ);
+	buf_add_uint32(&buf, 0);
+	err = sftp_request(sf->conn, SSH_FXP_OPEN, &buf,
+			   SSH_FXP_HANDLE, handle);
+	buf_free(&buf);
+	if (!err)
+		buf_finish(handle);
+	return err;
+}
+
+static void sshfs_close_transient_read(struct sshfs_file *sf,
+				       struct buffer *handle)
+{
+	sftp_request(sf->conn, SSH_FXP_CLOSE, handle, 0, NULL);
+	buf_clear(handle);
+}
